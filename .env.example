# A PostgreSQL connection string. Neon's free tier works and needs no card:
#   https://neon.tech  →  create a project  →  copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional. The role the verifier reads with.
#
# Leave it unset and the demo uses DATABASE_URL for both halves, which works but
# is not how you would run this. In production the runner holds a role with
# SELECT and nothing else, so verification is incapable of causing the effect it
# is checking for. The demo prints the SQL to create one.
# DATABASE_READ_URL=
