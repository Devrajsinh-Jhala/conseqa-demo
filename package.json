{
  "name": "conseqa-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 15-second demo: an agent writes to a real database, the reply is lost, and Conseqa recovers the truth without retrying.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contracts:build": "conseqa contracts build --directory .",
    "contracts:test": "conseqa contracts test --directory .",
    "test:callbacks": "tsx --test contracts/runner.test.ts",
    "test": "npm run typecheck && npm run test:callbacks && npm run contracts:build && npm run contracts:test",
    "demo": "npm run contracts:build && tsx src/demo.ts"
  },
  "dependencies": {
    "@conseqa/contracts": "^0.1.0",
    "@conseqa/runner": "^0.1.0",
    "@conseqa/sdk": "^0.1.0",
    "@conseqa/verifiers": "^0.1.0",
    "@neondatabase/serverless": "^1.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@conseqa/cli": "^0.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
